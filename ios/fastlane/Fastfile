default_platform(:ios)

APP_STORE_CONNECT_BUNDLE_IDENTIFIER = ENV["APP_STORE_CONNECT_BUNDLE_IDENTIFIER"]

SIGNING_KEYCHAIN = "ci-signing"
SIGNING_TARGETS = {
  "Runner" => APP_STORE_CONNECT_BUNDLE_IDENTIFIER,
  "CourseAppWidgetExtension" => "#{APP_STORE_CONNECT_BUNDLE_IDENTIFIER}.CourseWidget",
}

platform :ios do
  # Self-hosted runners run as a dedicated account without a login keychain
  # or Xcode Apple ID, so signing assets come from match into a throwaway keychain.
  lane :signing do |options|
    keychain_password = SecureRandom.hex(24)
    delete_keychain(name: SIGNING_KEYCHAIN) if File.exist?(File.expand_path("~/Library/Keychains/#{SIGNING_KEYCHAIN}-db"))
    create_keychain(
      name: SIGNING_KEYCHAIN,
      password: keychain_password,
      unlock: true,
      timeout: 0,
      default_keychain: false,
      add_to_search_list: true
    )

    api_key = app_store_connect_api_key(
      key_id: options[:key_id],
      issuer_id: options[:issuer_id],
      key_filepath: "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: SIGNING_TARGETS.values,
      api_key: api_key,
      readonly: ENV["MATCH_READONLY"] != "false",
      git_url: "git@github.com:abc873693/certificates.git",
      git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"],
      keychain_name: SIGNING_KEYCHAIN,
      keychain_password: keychain_password
    )

    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    SIGNING_TARGETS.each do |target, app_id|
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release"],
        team_id: ENV["DEVELOPER_PORTAL_TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[app_id]
      )
    end

    profile_entries = profiles.map { |id, name| "    <key>#{id}</key><string>#{name}</string>" }.join("\n")
    File.write("../ExportOptions.plist", <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>signingStyle</key><string>manual</string>
        <key>teamID</key><string>#{ENV["DEVELOPER_PORTAL_TEAM_ID"]}</string>
        <key>provisioningProfiles</key>
        <dict>
      #{profile_entries}
        </dict>
      </dict>
      </plist>
    PLIST
  end

  lane :release do |options|
    key_id = options[:key_id]
    issuer_id = options[:issuer_id]

    changelog_file = "./zh-TW.txt"
    changelog = File.exist?(changelog_file) ? File.read(changelog_file) : "Bug fixes and improvements."

    api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: "./AuthKey.p8",
        duration: 1200,
        in_house: false
    )

    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_files = Dir["#{ipa_dir}/*.ipa"]
    UI.message("Looking for IPA in: #{ipa_dir}")
    UI.message("Found files: #{Dir["#{ipa_dir}/*"].join(', ')}")
    raise "No IPA file found in #{ipa_dir}" if ipa_files.empty?
    ipa_path = ipa_files.first

    localized_info = {
      "default": {
        whats_new: changelog,
      },
    }

    en_file = "./en-US.txt"
    if File.exist?(en_file)
      localized_info["en-US"] = { whats_new: File.read(en_file) }
    end

    upload_to_testflight(
      app_identifier: "#{APP_STORE_CONNECT_BUNDLE_IDENTIFIER}",
      api_key: api_key,
      ipa: ipa_path,
      skip_submission: true,
      notify_external_testers: true,
      changelog: changelog,
      localized_build_info: localized_info,
    )
  end
end
